// 프로그래머스는 처음이라

#include <iostream>
#include <string>
#include <vector>

using namespace std;

// DFS 함수 선언
void dfs(vector<int> numbers, int target, int count, int total);

// 변수 선언
int totalResult = 0;

// 메인 함수
int main(void) {
    // 빠른 입출력
	ios::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);

    vector<int> numbers;
    int targetNum;

	cout << "Please input 5 numbers: \n";
    for (int i = 0; i < 5; i++) {
        int input; cin >> input;
        numbers.push_back(input);
    }
	cout << "Input target number: ";
    cin >> targetNum;

	dfs(numbers, targetNum, 0, 0);

	cout << totalResult << "\n";
}

void dfs(vector<int> numbers, int target, int count, int total) {
    if (numbers.size() == count) {
        if (total == target) {
            totalResult++;
            return;
        }
        else return;
    }

    dfs(numbers, target, count + 1, total + numbers[count]);
    dfs(numbers, target, count + 1, total - numbers[count]);

    return;
}